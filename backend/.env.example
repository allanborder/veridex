# VERIDEX Environment Configuration
# Target hardware ceiling: <= 8GB RAM. Local inference only, no paid 3rd party APIs.

# Embeddings Model (Local Sentence-Transformers)
VERIDEX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Answering Model Configuration
# Options: 'flan-t5' (HuggingFace google/flan-t5-base), 'ollama' (Local Ollama daemon), or 'extractive'
VERIDEX_LLM_PROVIDER=flan-t5
VERIDEX_LLM_MODEL=google/flan-t5-base
OLLAMA_BASE_URL=http://localhost:11434

# NLI Model (Cross-encoder or MNLI classifier)
# Options: 'roberta-snli' (cross-encoder/nli-distilroberta-base), 'minilm-nli' or 'rule-augmented'
VERIDEX_NLI_MODEL=cross-encoder/nli-distilroberta-base

# Ingestion & Chunking parameters
VERIDEX_CHUNK_SIZE=600
VERIDEX_CHUNK_OVERLAP=80

# Retrieval parameters
VERIDEX_TOP_K=4
VERIDEX_MIN_SIMILARITY=0.25

# Proposed Reliability Formulation Weights
# Reliability = (w_s * S - w_c * C - w_n * N - w_i * I)
VERIDEX_SUPPORT_WEIGHT=1.0
VERIDEX_CONTRADICTION_WEIGHT=1.8
VERIDEX_NEUTRAL_WEIGHT=0.3
VERIDEX_INCONSISTENCY_WEIGHT=1.2

# Illustrative Verdict Thresholds
VERIDEX_TRUSTWORTHY_THRESHOLD=0.85
VERIDEX_PARTIAL_THRESHOLD=0.60
VERIDEX_MISLEADING_THRESHOLD=0.35

# Paths
VERIDEX_DATA_DIR=data/documents
VERIDEX_INDEX_DIR=data/index
